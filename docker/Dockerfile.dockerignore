!uv.lock
!.python-version
!README.md
!LICENSE
!src/
!migrations/
!workspace/
!docker/install-agent.sh
!docker/install-pg-client.sh
!docker/setup-users.sh
!docker/run-as-agent.c
!docker/build-run-as-agent.sh
!docker/bridge-start.sh
**/__pycache__
**/*.pyc
**/.DS_Store
