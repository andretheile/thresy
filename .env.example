# Copy to .env and fill in. Never commit .env.
#
# Two uses of this one file:
#  * Local development: `coach` reads the COACH_* values directly (prefix COACH_, plus .env).
#  * Server (compose.yml): Compose only reads this file to fill in compose.yml. Each service
#    receives just the variables compose.yml lists for it; nothing here reaches a container
#    unless compose.yml names it.
# Unknown COACH_* keys are fine: each package reads its own.

# =============================================================================================
# db: role passwords (compose.yml builds the three database URLs from them)
# =============================================================================================
# Letters and digits only: the passwords end up inside connection URLs. They are applied when
# the database volume is first created; changing them later needs ALTER ROLE.
DB_SUPERUSER_PASSWORD=
DB_APP_PASSWORD=
DB_AGENT_PASSWORD=
DB_RO_PASSWORD=
# DB_MEM_LIMIT=512m

# =============================================================================================
# Local development only (compose.dev.yml). On the server compose.yml sets these itself.
# =============================================================================================
COACH_DATABASE_URL=postgresql://coach_app:coach_app@127.0.0.1:55432/thresy
COACH_DATABASE_URL_RO=postgresql://coach_ro:coach_ro@127.0.0.1:55432/thresy
COACH_AGENT_DATABASE_URL=postgresql://coach_agent:coach_agent@127.0.0.1:55432/thresy
# private/ is ignored by git
COACH_DATA_DIR=./private/data
COACH_WORKSPACE_DIR=./private/workspace
COACH_GARMIN_TOKEN_DIR=./private/garmin
# The old bot's export (importer and parity tests only).
# COACH_LEGACY_DIR=./legacy

# =============================================================================================
# sync and bridge
# =============================================================================================
# The athlete's IANA time zone.
COACH_TZ=UTC

# =============================================================================================
# sync only: Garmin Connect
# =============================================================================================
COACH_GARMIN_EMAIL=
COACH_GARMIN_PASSWORD=
# SYNC_MEM_LIMIT=512m

# =============================================================================================
# bridge only: chat, coach persona and the coding agent
# =============================================================================================
COACH_LANGUAGE=en
# The name the coach uses for itself.
COACH_NAME=Thresy
COACH_TELEGRAM_TOKEN=
# Comma-separated allow-list of chat ids.
COACH_TELEGRAM_CHAT_IDS=

# Coding agent: claude | codex | cursor | fake
COACH_RUNNER=claude
# Model credential for the chosen harness (set only the one you use).
#   Claude Code with a subscription: create the token with `claude setup-token`.
#   Never set ANTHROPIC_API_KEY: it would take precedence over the subscription token.
CLAUDE_CODE_OAUTH_TOKEN=
# CODEX_API_KEY=
# CURSOR_API_KEY=

# Per-runner settings (<NAME> is CLAUDE, CODEX or CURSOR). Leave them commented out to use the
# runner's defaults: an empty value is not the same as unset (an empty PERMISSION_ARGS, for
# example, means "no permission flags").
# COACH_CLAUDE_BIN=claude
# COACH_CLAUDE_ARGS=--max-turns 40
# COACH_CLAUDE_PERMISSION_ARGS=
# COACH_CLAUDE_MODEL_FAST=haiku
# COACH_CLAUDE_MODEL_SMART=opus
# COACH_CLAUDE_ENV=KEY=value OTHER=value
# COACH_CODEX_MODEL_FAST=
# COACH_CODEX_MODEL_SMART=
# COACH_CURSOR_MODEL_FAST=
# COACH_CURSOR_MODEL_SMART=
# BRIDGE_MEM_LIMIT=1536m

# =============================================================================================
# Image build (compose.yml build arguments)
# =============================================================================================
# Coding-agent CLI baked into the image: claude | codex | cursor | none
AGENT_CLI=claude
# Pinned agent CLI version, required for claude and codex ("latest" opts out). For claude this
# is the apt package version of the stable channel; upgrade by changing it and rebuilding.
AGENT_CLI_VERSION=2.1.311-1
