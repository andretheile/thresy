# Copy to .env and fill in. Never commit .env.
#
# Two uses of this one file:
#  * Local development: `coach` reads the COACH_* values directly (prefix COACH_, plus .env).
#  * Server (compose.yml): Compose only reads this file to fill in compose.yml. Each service
#    receives just the variables compose.yml lists for it; nothing here reaches a container
#    unless compose.yml names it. docs/deploy.md walks through a first deployment.
# Unknown COACH_* keys are fine: each package reads its own. Leave optional settings commented
# out: an empty value is not always the same as unset.

# =============================================================================================
# db: role passwords (compose.yml builds the three database URLs from them)
# =============================================================================================
# Letters and digits only: the passwords end up inside connection URLs. Generate each with
#   openssl rand -hex 24
# They are applied when the database volume is first created; changing them later needs
# ALTER ROLE.
DB_SUPERUSER_PASSWORD=
DB_APP_PASSWORD=
DB_AGENT_PASSWORD=
DB_RO_PASSWORD=
# DB_MEM_LIMIT=512m

# =============================================================================================
# Local development only (compose.dev.yml). On the server compose.yml sets these itself.
# =============================================================================================
COACH_DATABASE_URL=postgresql://coach_app:coach_app@127.0.0.1:55432/thresy
COACH_DATABASE_URL_RO=postgresql://coach_ro:coach_ro@127.0.0.1:55432/thresy
COACH_AGENT_DATABASE_URL=postgresql://coach_agent:coach_agent@127.0.0.1:55432/thresy
# private/ is ignored by git
COACH_DATA_DIR=./private/data
COACH_WORKSPACE_DIR=./private/workspace
COACH_GARMIN_TOKEN_DIR=./private/garmin
# The old bot's export (importer and parity tests only).
# COACH_LEGACY_DIR=./legacy

# =============================================================================================
# sync, bridge and backup
# =============================================================================================
# The athlete's IANA time zone, e.g. Europe/Berlin.
COACH_TZ=UTC

# =============================================================================================
# sync only: Garmin Connect
# =============================================================================================
# Needed only for the first login (docs/deploy.md). Once `coach sync status` shows a working
# login, the session lives in the garmin-auth volume: remove both values from .env and run
# `docker compose up -d sync` so they are gone from the container as well.
COACH_GARMIN_EMAIL=
COACH_GARMIN_PASSWORD=
# SYNC_MEM_LIMIT=384m
#
# Optional tuning (defaults in docs/sync.md):
# COACH_SYNC_INTERVAL_S=1200
# COACH_SYNC_MORNING_START=05:00
# COACH_SYNC_MORNING_END=11:00
# COACH_SYNC_MORNING_INTERVAL_S=300
# COACH_SYNC_LOOKBACK_DAYS=7
# COACH_SYNC_BACKFILL_PAUSE_S=2
# (also COACH_SYNC_NEW_ACTIVITY_MAX_AGE_H, _JITTER_S, _REQUEST_CHECK_S, _RECHECK_DAYS,
#  _RECHECK_INTERVAL_S, _STEPS_FINAL_AFTER_H, _PR_REFRESH_H, _FIT_MAX_ATTEMPTS, _LOGIN_RETRY_H,
#  _RATE_LIMIT_BACKOFF_S, _RATE_LIMIT_BACKOFF_MAX_S, _FAIL_EVENT_AFTER)

# =============================================================================================
# bridge only: chat, coach persona and the coding agent
# =============================================================================================
COACH_LANGUAGE=en
# The name the coach uses for itself.
COACH_NAME=Thresy
# The athlete's home location for `coach weather` (format: `coach weather --help`); the
# bridge hands it to the agent.
# COACH_HOME_LOCATION=
COACH_TELEGRAM_TOKEN=
# Comma-separated allow-list of chat ids. The FIRST id receives the proactive messages
# (morning briefing, run debriefs, warnings); the others can only chat.
COACH_TELEGRAM_CHAT_IDS=

# Coding agent: claude | codex | cursor | fake
COACH_RUNNER=claude
# The bridge starts the agent CLI as this Unix user of the image (default: agent). Leave it
# alone; set it to an empty value only for local development without a second user.
# COACH_AGENT_USER=agent
#
# Model credential. On the server, put it into the agent's own credential file instead
# (docs/deploy.md, "The model credential"): then it is not in the bridge's environment at all.
# For local development, or as a fallback, set the one of your harness here.
#   Claude Code with a subscription: create the token with `claude setup-token`.
#   Never set ANTHROPIC_API_KEY: it would take precedence over the subscription token.
# CLAUDE_CODE_OAUTH_TOKEN=
# CODEX_API_KEY=
# CURSOR_API_KEY=

# Per-runner settings (<NAME> is CLAUDE, CODEX or CURSOR). Leave them commented out to use the
# runner's defaults: an empty value is not the same as unset (an empty PERMISSION_ARGS, for
# example, means "no permission flags").
# COACH_CLAUDE_BIN=claude
# COACH_CLAUDE_ARGS=--max-turns 40
# COACH_CLAUDE_PERMISSION_ARGS=
# COACH_CLAUDE_MODEL_FAST=haiku
# COACH_CLAUDE_MODEL_SMART=opus
# COACH_CLAUDE_ENV=KEY=value OTHER=value
# COACH_CLAUDE_EXIT_WAIT_S=10
# Bridge variables the agent may inherit (compose.yml's default shown; keep it):
# COACH_CLAUDE_PASS_ENV=DISABLE_AUTOUPDATER
# COACH_CODEX_MODEL_FAST=
# COACH_CODEX_MODEL_SMART=
# COACH_CURSOR_MODEL_FAST=
# COACH_CURSOR_MODEL_SMART=
# BRIDGE_MEM_LIMIT=1536m
#
# Optional bridge tuning (defaults in docs/bridge.md):
# COACH_BRIDGE_QUIET_HOURS=22:00-06:00
# COACH_BRIDGE_BRIEFING=true
# COACH_BRIDGE_BRIEFING_FALLBACK=10:00
# COACH_BRIDGE_BRIEFING_LATEST=14:00
# COACH_BRIDGE_DEBRIEF=true
# COACH_BRIDGE_DEBRIEF_DELAY_S=180
# COACH_BRIDGE_RUN_TIMEOUT_S=900
# COACH_BRIDGE_CHAT_TIER=smart
# COACH_BRIDGE_PROACTIVE_TIER=smart
# COACH_BRIDGE_NOTIFY_INTERVAL_H=12
# (also COACH_BRIDGE_TRANSPORT, _NIGHT_END_EARLIEST, _BRIEFING_SETTLE_S, _DEBRIEF_MAX_WAIT_S,
#  _DEBRIEF_MAX_AGE_H, _SYNC_FAILED_THRESHOLD, _SYNC_FAILED_WINDOW_H, _CONTEXT_MESSAGES,
#  _CONTEXT_CHARS, _CONTEXT_HOURS, _REQUEUE_MINUTES, _OUTBOX_POLL_S, _EVENTS_POLL_S,
#  _SEND_ATTEMPTS, _SYNC_REQUEST_TIMEOUT_S, _SHUTDOWN_GRACE_S)

# =============================================================================================
# backup only (docs/backup.md)
# =============================================================================================
# Target: a bucket (gs://bucket/prefix) or a directory (file:///path). Default in compose.yml:
# file:///backups, a volume on the same host, which protects against mistakes but not against
# losing the server.
# COACH_BACKUP_URL=gs://<bucket>/<prefix>
# Host path of the bucket's create-only service-account key (JSON), readable by uid 10001.
# COACH_BACKUP_GCS_KEY_FILE=./secrets/gcs-backup-key.json
# age public key(s): everything is encrypted before it leaves the host. The private key stays
# off the server; without it the backups cannot be restored.
# COACH_BACKUP_AGE_RECIPIENT=age1...
# Local time of the nightly run, and how often it also test-restores the dump (0: never).
# COACH_BACKUP_AT=03:30
# COACH_BACKUP_RESTORE_CHECK_DAYS=7
# BACKUP_MEM_LIMIT=256m

# =============================================================================================
# Image build (compose.yml build arguments)
# =============================================================================================
# Coding-agent CLI baked into the image: claude | codex | cursor | none
AGENT_CLI=claude
# Pinned agent CLI version, required for claude and codex ("latest" opts out). For claude this
# is the apt package version of the stable channel; upgrade by changing it and rebuilding.
AGENT_CLI_VERSION=2.1.311-1
