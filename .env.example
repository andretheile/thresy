# Copy to .env and adjust. Settings are read from the environment (prefix COACH_) and from .env.
# The values below match compose.dev.yml (local development only).

# --- Database ------------------------------------------------------------------------------
COACH_DATABASE_URL=postgresql://coach_app:coach_app@127.0.0.1:55432/thresy
COACH_DATABASE_URL_RO=postgresql://coach_ro:coach_ro@127.0.0.1:55432/thresy

# --- Paths (private/ is ignored by git) ----------------------------------------------------
COACH_DATA_DIR=./private/data
COACH_WORKSPACE_DIR=./private/workspace

# --- Athlete and coach ---------------------------------------------------------------------
COACH_TZ=UTC
COACH_LANGUAGE=en
# The name the coach uses for itself.
COACH_NAME=Thresy

# --- Coding agent --------------------------------------------------------------------------
# claude | codex | cursor | fake
COACH_RUNNER=claude
# COACH_RUNNER_MODEL_FAST=
# COACH_RUNNER_MODEL_SMART=
# COACH_RUNNER_TIMEOUT_S=900
# Claude Code with a subscription: create a token with `claude setup-token`.
# CLAUDE_CODE_OAUTH_TOKEN=

# --- Telegram ------------------------------------------------------------------------------
# COACH_TELEGRAM_TOKEN=
# Comma-separated allow-list of chat ids.
# COACH_TELEGRAM_CHAT_IDS=

# --- Old bot export (importer and parity tests only) ---------------------------------------
# COACH_LEGACY_DIR=./legacy

# --- Production stack only (compose.yml) ---------------------------------------------------
# Passwords for the Postgres superuser and the two application roles. compose.yml builds the
# COACH_DATABASE_URL* values from these (and overrides the URLs above inside the containers).
# Use letters and digits only: the passwords end up inside connection URLs. They are applied
# when the database volume is first created; changing them later needs ALTER ROLE.
# DB_SUPERUSER_PASSWORD=
# DB_APP_PASSWORD=
# DB_RO_PASSWORD=
# Coding agent CLI baked into the image: claude | codex | cursor | none
# AGENT_CLI=claude
